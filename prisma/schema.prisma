generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================
// SCHEMA METADATA - Metadados mínimos dos schemas
// =============================================================

// Metadados básicos dos schemas criados (apenas informação auxiliar)
model SchemaMetadata {
  id                  String   @id @default(cuid())
  schemaId            String   // "user_profile" (legível)
  schemaIdBytes32     String   // "0x75736572..." (bytes32 para contrato)
  schemaName          String   // "User Profile Schema" (descritivo)
  channelName         String   // "coffee_channel"
  channelNameBytes32  String   // "coffee_channel"
  transactionHash     String   @unique // "0xabc..." (hash da tx de criação)
  walletAddress       String   // Endereço que criou o schema
  createdAt           DateTime @default(now())
  
  // Garantir unicidade por canal (mesmo que no contrato)
  @@unique([schemaId, channelName])
  @@map("schema_metadata")
}



